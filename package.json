{
  "name": "fistulab",
  "private": true,
  "version": "1.0.0",
  "description": "Fistulab: simulador de punción ecoguiada de la fístula arteriovenosa (FAV) para hemodiálisis, en el navegador",
  "homepage": "https://fistulab.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guithar/ecografo-virtual.git"
  },
  "bugs": {
    "url": "https://github.com/Guithar/ecografo-virtual/issues"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/fistulab"
  },
  "keywords": [
    "ecografía",
    "hemodiálisis",
    "fístula arteriovenosa",
    "acceso vascular",
    "punción ecoguiada",
    "simulador",
    "ultrasound",
    "cannulation",
    "AVF",
    "webgl"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
