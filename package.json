{
  "name": "ecografo-virtual",
  "private": true,
  "version": "0.1.0",
  "description": "Simulador virtual de ecografía para punción ecoguiada de fístula arteriovenosa (FAV) en el navegador",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/"
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
